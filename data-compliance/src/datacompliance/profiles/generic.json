  "max_text_mb": 50,
  "max_pkl_mb": 200,
  "csv_sample_rows": 2000,
  "path_patterns": [
    {
      "name": "unix_home_dir",
      "regex": "/(?:home|Users)/[A-Za-z0-9_.-]+",
      "severity": "MEDIUM",
      "hint": "Absolute home directory \u2014 identifies the user and machine; replace with a config variable or ~"
    },
    {
      "name": "mount_data_root",
      "regex": "/(?:mnt|media|data|scratch|vol|nfs|gpfs|lustre|Volumes)/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?",
      "severity": "MEDIUM",
      "hint": "Absolute storage mount \u2014 server-specific; replace with a DATA_ROOT config variable"
    },
    {
      "name": "email_address",
      "regex": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
      "severity": "LOW",
      "hint": "Email address in source \u2014 fine in headers/citations, check it is not a data subject"
    },
    {
      "name": "private_key_block",
      "regex": "-----BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----",
      "severity": "HIGH",
      "hint": "Private key material committed to the tree"
    },
    {
      "name": "aws_access_key",
      "regex": "\\bAKIA[0-9A-Z]{16}\\b",
      "severity": "HIGH",
      "hint": "AWS access key ID"
    },
    {
      "name": "generic_api_token",
      "regex": "(?i)\\b(?:api[_-]?key|secret[_-]?key|access[_-]?token|auth[_-]?token|password)\\s*[:=]\\s*[\"']([^\"'\\s]{12,})[\"']",
      "severity": "HIGH",
      "hint": "Hardcoded credential \u2014 move to an environment variable"
    },
    {
      "name": "ssh_host_reference",
      "regex": "(?i)\\b(?:ssh|scp|rsync)\\s+(?:-[A-Za-z0-9]+\\s+)*[A-Za-z0-9_.-]+@[A-Za-z0-9_.-]+\\b",
      "severity": "LOW",
      "hint": "Hostname/user in a remote-copy command \u2014 identifies infrastructure"
    }
  ],
  "path_pattern_allow": [
    "/mnt/c/",
    "/data/local"
  ],
  "sensitive_filenames": [
    {
      "regex": "(?i)(?:^|[._-])(?:secret|credential)s?(?:[._-]|$)",
      "severity": "HIGH",
      "note": "Filename indicates stored credentials"
    },
    {
      "regex": "(?i)\\.(?:pem|key|p12|pfx|jks|keystore)$",
      "severity": "HIGH",
      "note": "Key material"
    },
    {
      "regex": "^\\.netrc$",
      "severity": "HIGH",
      "note": ".netrc stores machine/login/password in plaintext"
    },
    {
      "regex": "^(?:adc|application_default_credentials)\\.json$",
      "severity": "HIGH",
      "note": "Google application default credentials \u2014 may embed a service-account private key"
    },
    {
      "regex": "^\\.(?:boto|pgpass|git-credentials)$",
      "severity": "HIGH",
      "note": "Tool config that commonly holds plaintext tokens"
    },
    {
      "regex": "^credentials(\\.db)?$",
      "severity": "HIGH",
      "note": "Credential store"
    },
    {
      "regex": "^id_(?:rsa|dsa|ecdsa|ed25519)$",
      "severity": "HIGH",
      "note": "SSH private key"
    },
    {
      "regex": "(?i)^\\.?(?:bash|zsh|mysql|psql|python|r)_?history$",
      "severity": "MEDIUM",
      "note": "Shell/REPL history \u2014 commands may embed credentials or identifiers"
    },
    {
      "regex": "^\\.(?:npmrc|pypirc|docker/config\\.json)$",
      "severity": "LOW",
      "note": "Registry config \u2014 HIGH only if it contains an auth token"
    },
    {
      "regex": "^login\\.keychain(-db)?$|\\.keychain(-db)?$",
      "severity": "HIGH",
      "note": "macOS keychain \u2014 stored credentials"
    }
  ],
  "bulk_data_ext": [
    ".pkl",
    ".pickle",
    ".parquet",
    ".feather",
    ".csv",
