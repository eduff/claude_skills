{
  "name": "generic",
  "description": "Baseline rules: numeric participant IDs, local-path leakage, credential patterns",
  "id": {
    "label": "id",
    "long_label": "participant identifier",
    "regex": "(?<![.\\d])\\b[1-9][0-9]{6}\\b(?!\\d)",
    "min": 1000000,
    "max": 9999999,
    "column_names": [
      "id",
      "participant_id",
      "participantid",
      "subject_id",
      "subjectid",
      "patient_id",
      "patientid",
      "sample_id",
      "sampleid",
      "record_id"
    ],
    "column_prefixes": []
  },
  "positive_context": [
